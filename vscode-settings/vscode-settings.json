{
  // DEFAULT FORMATTERS
  // "[php]": {
  //   "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
  // },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  // WORKBENCH SETTINGS
  "workbench.statusBar.visible": false,
  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.fontAliasing": "antialiased",
  "workbench.editor.useModal": "off",
  "workbench.browser.showInTitleBar": false,
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.tips.enabled": false,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.editor.decorations.badges": true,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.tree.indent": 15,
  "workbench.colorCustomizations": {
    "sideBar.background": "#171717",
    "editor.lineHighlightBackground": "#E3E3E3",
    "editor.background": "#171717",
    "editorGutter.background": "#171717",
    "tab.activeBackground": "#202020",
    "tab.activeForeground": "#ededed",
    "tab.inactiveBackground": "#171717",
    "tab.border": "#202020",
    "tab.activeBorderTop": "#404040",
    "titleBar.activeBackground": "#171717",
    "titleBar.inactiveBackground": "#171717",
    "editorGroupHeader.connectedTabsBackground": "#171717"
  },
  // EDITOR SETTINGS
  "editor.fontFamily": "CaskaydiaMono Nerd Font",
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.fontWeight": "450",
  "editor.fontSize": 15,
  "editor.fontLigatures": false,
  "editor.lineNumbers": "relative",
  "editor.overviewRulerBorder": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.allowVariableFonts": false,
  "editor.fontVariations": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.occurrencesHighlight": "off",
  "editor.lineHeight": 1.35,
  "editor.stickyScroll.enabled": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.emptySelectionClipboard": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": false,
  "editor.guides.indentation": false,
  "editor.hover.delay": 1500,
  "editor.matchBrackets": "never",
  "editor.colorDecorators": false,
  "editor.lightbulb.enabled": "off",
  "editor.selectionHighlight": false,
  "editor.renderLineHighlight": "none",
  "editor.renderControlCharacters": false,
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.minimap.enabled": false,
  "editor.semanticTokenColorCustomizations": {
    "[React Theme]": {
      "rules": {
        "variable": "#E6E6E6"
      }
    }
  },
  // OTHER SETTINGS
  "problems.decorations.enabled": true,
  "explorer.decorations.badges": true,
  "explorer.decorations.colors": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "window.newWindowDimensions": "inherit",
  "diffEditor.renderSideBySide": false,
  "window.nativeFullScreen": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "scm.diffDecorations": "none",
  "git.decorations.enabled": false,
  "material-icon-theme.files.color": "#90a4ae",
  "breadcrumbs.enabled": false,
  "window.commandCenter": false,
  "extensions.ignoreRecommendations": true,
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "diffEditor.wordWrap": "on",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "svelte.enable-ts-plugin": true,
  "python.analysis.typeCheckingMode": "standard",
  // VIM SETTINGS
  // Use space as leader key
  "vim.leader": " ",
  // Enable EasyMotion
  "vim.easymotion": true,
  // Normal mode keybindings
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      // s → EasyMotion forward (1 char)
      "before": ["s"],
      "after": ["<leader>", "<leader>", "f"]
    },
    {
      // H → previous tab
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      // L → next tab
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      // S → EasyMotion backward (1 char)
      "before": ["S"],
      "after": ["<leader>", "<leader>", "F"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      // Open command pallette
      "before": ["<leader>", "j"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      // Open file searcher
      "before": ["<leader>", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      // Go to definition
      "before": ["<leader>", "c", "c"],
      "commands": ["workbench.action.quickOpen"]
    }
  ],
  "vscode_custom_css.imports": [
    "file:///Users/tamasm/.config/vscode-custom/vscode-styles.css"
  ],
  "workbench.editor.empty.hint": "hidden",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "chat.disableAIFeatures": true,
  "explorer.confirmPasteNative": false,
  "workbench.colorTheme": "Dark Modern",
  "workbench.activityBar.location": "hidden"
}
