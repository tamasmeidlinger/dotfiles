{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "battery",
        "locale",
        "break",
    ],
    "display": {
        "color": {
            "output": "#9CCBEF",
        },
    },
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/ocsi-pixel.png",
        "width": 30
    },
}
